{
  "name": "sentinel-discord-bot-worker",
  "version": "1.0.0",
  "description": "Cloudflare Workers rewrite of the Sentinel Discord bot (HTTP Interactions + Cron, no discord.js gateway).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute sentinel-bot-db --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute sentinel-bot-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "discord-interactions": "^3.4.0"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}

# Discord Application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# The guild (server) you run this bot in — where private client channels get created.
GUILD_ID=

# Comma-separated Discord user IDs allowed to run /onboard.
ADMIN_USER_IDS=

# Channel (in GUILD_ID) where poll/post failures get escalated after
# repeated consecutive failures for a customer. Required.
ADMIN_ALERT_CHANNEL_ID=

# Where the SQLite state file lives.
DB_PATH=./data/bot.db

# How often to poll each customer's Sentinel instance, in ms.
POLL_INTERVAL_MS=60000

# Consecutive poll failures before escalating to ADMIN_ALERT_CHANNEL_ID.
FAILURE_ALERT_THRESHOLD=3

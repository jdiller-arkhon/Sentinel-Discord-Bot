# Discord Application (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# The channel where proposal messages get posted
DISCORD_CHANNEL_ID=

# Your own Discord user id — only this user's button clicks are honored
DISCORD_ALLOWED_USER_ID=

# Sentinel backend base URL (default: same-machine desktop app)
SENTINEL_BASE_URL=http://127.0.0.1:8765

# How often to poll Sentinel for new pending proposals
POLL_INTERVAL_SECONDS=60
